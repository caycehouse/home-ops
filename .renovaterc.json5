{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#12.0.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#12.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#12.0.0",
    ":timezone(America/New_York)",
  ],
  // The Main ruleset does not require up-to-date branches, and `auto` would
  // still rebase every automerge PR each time main moves
  rebaseWhen: "conflicted",
  customManagers: [
    {
      description: "Process CNPG extension image references",
      customType: "regex",
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "reference:\\s+(?<depName>[^@\\s]+):(?<currentValue>[^@\\s/]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
    },
  ],
  customDatasources: {
    // CurseForge's own API needs an x-api-key header; cfwidget is an
    // unauthenticated proxy over the same data.
    "curseforge-modpack": {
      defaultRegistryUrlTemplate: "https://api.cfwidget.com/minecraft/modpacks/{{packageName}}",
      format: "json",
      transformTemplates: [
        '{"releases": [files[type="release"].{"version": $match(display, /[0-9]+(\\.[0-9]+)+[a-z]?$/)[0].match, "releaseTimestamp": uploaded_at}]}',
      ],
    },
    // FTB's own API. The FTBA installer only accepts a numeric version id,
    // so this tracks ids, not the readable release names. Ids rise with
    // release date, so ordering holds.
    "ftb-modpack": {
      defaultRegistryUrlTemplate: "https://api.feed-the-beast.com/v1/modpacks/public/modpack/{{packageName}}",
      format: "json",
      transformTemplates: [
        '{"releases": [versions[type="release" and private=false].{"version": $string(id), "releaseTimestamp": $fromMillis(released * 1000)}]}',
      ],
    },
  },
  packageRules: [
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 minute",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Never auto-merge CurseForge modpacks; updating one rewrites a live world",
      matchDatasources: ["custom.curseforge-modpack"],
      versioning: "deb",
      automerge: false,
      addLabels: ["modpack"],
      changelogUrl: "https://www.curseforge.com/minecraft/modpacks/{{depName}}/files/all",
    },
    {
      description: "Never auto-merge FTB modpacks; updating one rewrites a live world",
      matchDatasources: ["custom.ftb-modpack"],
      versioning: "regex:^(?<major>\\d+)$",
      automerge: false,
      addLabels: ["modpack"],
      changelogUrl: "https://www.feed-the-beast.com/modpacks/{{depName}}",
    },
    // Changelog rules
    {
      description: "Point Actual at its upstream changelog",
      matchPackageNames: ["/actualbudget\\/actual$/"],
      changelogUrl: "https://actualbudget.org/docs/releases/",
      sourceUrl: "https://github.com/actualbudget/actual",
    },
    {
      description: "Point TwitchDropsMiner at its upstream changelog",
      matchPackageNames: ["/twitch-drops-miner/"],
      changelogUrl: "https://github.com/fireph/docker-twitch-drops-miner/commits/main",
    },
    {
      description: "Point Agent Router at its upstream changelog",
      matchPackageNames: ["/ai-gateway-crds-helm$/", "/ai-gateway-helm$/"],
      sourceUrl: "https://github.com/theagentrouter/agent-router",
    },
    {
      description: "Point Envoy at its upstream changelog",
      matchPackageNames: ["/envoyproxy\\/envoy$/"],
      sourceUrl: "https://github.com/envoyproxy/envoy",
    },
    {
      description: "Point Grafana Operator at its upstream changelog",
      matchPackageNames: ["/helm-charts\\/grafana-operator$/"],
      sourceUrl: "https://github.com/grafana/grafana-operator",
    },
    {
      description: "Point External Secrets at its upstream changelog",
      matchPackageNames: ["/charts\\/external-secrets$/"],
      sourceUrl: "https://github.com/external-secrets/external-secrets",
    },
    {
      description: "Point 1Password Connect at its upstream changelog",
      matchPackageNames: ["/1password\\/connect$/"],
      changelogUrl: "https://github.com/1Password/connect-helm-charts/releases/tag/connect-{{newVersion}}",
      sourceUrl: "https://github.com/1Password/connect-helm-charts",
    },
    {
      description: "Point UniFi Network MCP at its upstream changelog",
      matchPackageNames: ["/unifi-network-mcp/"],
      changelogUrl: "https://github.com/sirkirby/unifi-mcp/releases/tag/network/v{{newVersion}}",
      sourceUrl: "https://github.com/sirkirby/unifi-mcp",
    },
    {
      description: "Point Prometheus Blackbox Exporter chart at its upstream changelog",
      matchPackageNames: ["/prometheus-community\\/charts\\/prometheus-blackbox-exporter$/"],
      changelogUrl: "https://github.com/prometheus-community/helm-charts/releases/tag/prometheus-blackbox-exporter-{{newVersion}}",
      sourceUrl: "https://github.com/prometheus-community/helm-charts",
    },
    {
      description: "Point Prometheus Smartctl Exporter chart at its upstream changelog",
      matchPackageNames: ["/prometheus-community\\/charts\\/prometheus-smartctl-exporter$/"],
      changelogUrl: "https://github.com/prometheus-community/helm-charts/releases/tag/prometheus-smartctl-exporter-{{newVersion}}",
      sourceUrl: "https://github.com/prometheus-community/helm-charts",
    },
    {
      description: "Point Reloader at its upstream changelog",
      matchPackageNames: ["/stakater\\/charts\\/reloader$/"],
      changelogUrl: "https://github.com/stakater/Reloader/releases/tag/chart-v{{newVersion}}",
    },
    {
      description: "Point CoreDNS chart at its upstream changelog",
      matchPackageNames: ["/coredns\\/charts\\/coredns$/"],
      changelogUrl: "https://github.com/coredns/helm/releases/tag/coredns-{{newVersion}}",
    },
    {
      description: "Point Multus chart at its upstream changelog",
      matchPackageNames: ["/home-operations\\/charts\\/multus$/"],
      changelogUrl: "https://github.com/home-operations/helm-charts/releases/tag/multus-{{newVersion}}",
    },
    {
      description: "Point Snapshot Controller chart at its upstream changelog",
      matchPackageNames: ["/home-operations\\/charts\\/snapshot-controller$/"],
      changelogUrl: "https://github.com/home-operations/helm-charts/releases/tag/snapshot-controller-{{newVersion}}",
    },
    {
      description: "Point CloudNativePG PostgreSQL at its upstream changelog",
      matchPackageNames: ["/cloudnative-pg\\/postgresql$/"],
      changelogUrl: "https://www.postgresql.org/docs/release/{{newMajor}}.{{newMinor}}/",
      sourceUrl: "https://github.com/cloudnative-pg/postgres-containers",
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Agent Router Group",
      groupName: "agent-router",
      matchDatasources: ["docker"],
      matchPackageNames: ["/ai-gateway-crds-helm$/", "/ai-gateway-helm$/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
      separateMinorPatch: true,
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      // Unites the factory installer image and the tuppr upgrade version
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Each ClusterImageCatalog row is one Postgres major, so never move a row to the next major",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Postgres image rebuilds restart every database, so offer them weekly",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["digest"],
      schedule: ["before 6am on Monday"],
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
