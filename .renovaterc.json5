{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    ":timezone(America/New_York)",
  ],
  customDatasources: {
    // CurseForge's own API needs an x-api-key header; cfwidget is an
    // unauthenticated proxy over the same data.
    "curseforge-modpack": {
      defaultRegistryUrlTemplate: "https://api.cfwidget.com/minecraft/modpacks/{{packageName}}",
      format: "json",
      transformTemplates: [
        '{"releases": [files[type="release"].{"version": $match(display, /[0-9]+(\\.[0-9]+)+$/)[0].match, "releaseTimestamp": uploaded_at}]}',
      ],
    },
  },
  packageRules: [
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Never auto-merge CurseForge modpacks; updating one rewrites a live world",
      matchDatasources: ["custom.curseforge-modpack"],
      versioning: "loose",
      automerge: false,
      addLabels: ["modpack"],
      changelogUrl: "https://www.curseforge.com/minecraft/modpacks/{{depName}}/files/all",
    },
    // Changelog rules
    {
      description: "Point Actual at its upstream changelog",
      matchPackageNames: ["/actualbudget\\/actual$/"],
      changelogUrl: "https://actualbudget.org/docs/releases/",
      sourceUrl: "https://github.com/actualbudget/actual",
    },
    {
      description: "Point Atuin at its upstream changelog",
      matchPackageNames: ["/atuin/"],
      changelogUrl: "https://github.com/atuinsh/atuin/blob/main/CHANGELOG.md",
    },
    {
      description: "Point TwitchDropsMiner at its upstream changelog",
      matchPackageNames: ["/twitch-drops-miner/"],
      changelogUrl: "https://github.com/fireph/docker-twitch-drops-miner/commits/main",
    },
    {
      description: "Point Envoy at its upstream changelog",
      matchPackageNames: ["/envoyproxy\\/envoy$/"],
      sourceUrl: "https://github.com/envoyproxy/envoy",
    },
    {
      description: "Point Grafana Operator at its upstream changelog",
      matchPackageNames: ["/helm-charts\\/grafana-operator$/"],
      sourceUrl: "https://github.com/grafana/grafana-operator",
    },
    {
      description: "Point Silence Operator at its upstream changelog",
      matchPackageNames: ["/giantswarm\\/silence-operator$/"],
      sourceUrl: "https://github.com/giantswarm/silence-operator",
    },
    {
      description: "Point External Secrets at its upstream changelog",
      matchPackageNames: ["/charts\\/external-secrets$/"],
      sourceUrl: "https://github.com/external-secrets/external-secrets",
    },
    {
      description: "Point 1Password Connect at its upstream changelog",
      matchPackageNames: ["/1password\\/connect$/"],
      changelogUrl: "https://github.com/1Password/connect-helm-charts/releases/tag/connect-{{newVersion}}",
      sourceUrl: "https://github.com/1Password/connect-helm-charts",
    },
    {
      description: "Point UniFi Network MCP at its upstream changelog",
      matchPackageNames: ["/unifi-network-mcp/"],
      changelogUrl: "https://github.com/sirkirby/unifi-mcp/releases/tag/network/v{{newVersion}}",
      sourceUrl: "https://github.com/sirkirby/unifi-mcp",
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
